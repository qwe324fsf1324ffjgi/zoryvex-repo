# Secrets and environment
.env
.env.*
!.env.example

# Terraform state and locals
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# Throwaway data dir for `terraform validate` in validate:all and CI, so a
# validate never disturbs a real backend-initialised .terraform.
.terraform-validate/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# CI-generated mock Lambda-package placeholders for `terraform test` — never
# a real deploy artifact, regenerated fresh by .github/workflows/ci.yml.
infrastructure/envs/*/tests/mock-artifacts/

# Real Terraform variable files (only the *.example templates are committed —
# a real one carries environment-specific and founder-contact values that
# must never be committed, per CLAUDE.md's redaction rule)
terraform.tfvars
*.auto.tfvars
*.tfplan

# scripts/deploy.mjs's local artifact directory. The *.tfplan rule above
# already covers the saved plans themselves, but the directory was not
# ignored, so any non-.tfplan file written beside them was picked up by an
# ordinary `git add -A` (found in a 2026-08-27 audit, when exactly that
# happened). Nothing in here is repository content.
.terraform-plans/

# MCP config (may carry tokens)
.mcp.json

# Claude Code local settings
.claude/settings.local.json

# Playwright auth/session state
**/playwright/.auth/
**/test-results/
**/playwright-report/

# Credentials of any kind
*credentials*
*.pem
*.key
!**/example.*.key

# Node
node_modules/
npm-debug.log*

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo
coverage/

# Private founder assets (not for safe-shell; publish only after commercial GO)
assets/founder-private/

# OS
Thumbs.db
.DS_Store
# Generated by npm run demo:tour. Regenerate rather than commit.
demo-tour/

# Authenticated test-environment probes. They hold a live session cookie,
# so they are written here and never committed.
.tmp-e2e/

# Local environment secrets
.env
.env.*
!.env.example

# Dependencies and generated files
node_modules/
.next/
dist/
coverage/

# Local cloud credentials
.aws/

# Terraform state and plans
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars

# Private keys
*.pem
*.ppk
*.key

# Local Claude settings and session data
.claude/settings.local.json
.claude/projects/
