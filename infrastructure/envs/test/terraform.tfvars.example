# site_bucket_name, evidence_bucket_name, and evidence_scan_test_bucket_name
# are no longer variables — infrastructure/envs/test/main.tf now computes
# them deterministically from the account ID, same as oidc_provider_arn/
# state_bucket_arn (Phase 7 slice 9).
alert_email = "<founder-gmail>"

# *_deployment_package_path variables all default to
# ../../../services/api/dist/<name>.zip (built by `npm run build:lambda`) —
# override only if testing a package built somewhere else.

