{
  "name": "zoryvex-platform",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live-github": "vitest run services/api/tests/github-verification-live.test.ts",
    "build": "npm run build --workspaces --if-present",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "openapi:coverage": "node scripts/check-openapi-coverage.mjs",
    "static-export:assert": "node scripts/assert-static-export.mjs apps/web",
    "pages:check": "node scripts/check-page-titles.mjs apps/web",
    "static-export:assert:safe-shell": "node scripts/assert-static-export.mjs apps/web-safe-shell",
    "safe-shell:assert": "node scripts/assert-safe-shell.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "terraform:policy": "node scripts/terraform-policy-check.mjs",
    "real-mode:check": "node scripts/real-mode-awareness-check.mjs",
    "copy:voice": "node scripts/check-copy-voice.mjs",
    "gsi:check": "node scripts/check-gsi-grants.mjs",
    "fees:check": "node scripts/check-fee-table.mjs",
    "paystack:plans": "node scripts/paystack-create-plans.mjs",
    "flags:wiring": "node scripts/check-flag-env-wiring.mjs",
    "flags:check": "node scripts/check-feature-flags.mjs",
    "state:check": "node scripts/check-state-schema.mjs",
    "emergency:cost-lockdown": "node scripts/emergency-cost-lockdown.mjs",
    "verify:deployed": "node scripts/verify-deployment.mjs",
    "build:lambda": "node scripts/build-lambda.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "plans:check": "node scripts/check-plan-prices.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "validate:all": "node scripts/validate.mjs",
    "bundle:budget": "node scripts/assert-bundle-budget.mjs",
    "e2e": "node scripts/free-ports.mjs && playwright test",
    "ports:free": "node scripts/free-ports.mjs",
    "demo:tour": "node scripts/demo-tour.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "yazl": "3.3.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
